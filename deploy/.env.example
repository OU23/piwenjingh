# 复制为 deploy/.env 并填写；实际 .env 已被 Git 忽略。
# 数据库连接：宿主机 MySQL 使用 host.docker.internal。
SPRING_DATASOURCE_URL='jdbc:mysql://host.docker.internal:3306/toolbox?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=Asia/Shanghai'
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 填齐 OSS_ENDPOINT、OSS_BUCKET、两项 AccessKey 和 OSS_STS_ROLE_ARN 后改为 oss。
TOOLBOX_STORAGE_TYPE=local
# OSS 公网 Endpoint，不要使用 -internal 地址。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_TTL_SECONDS=3600
# 要扮演的 RAM 角色 ARN。
OSS_STS_ROLE_ARN=
# STS 临时凭证由应用动态申请；这里只配置申请参数。
OSS_STS_DURATION_SECONDS=3600
OSS_STS_ENDPOINT=sts.aliyuncs.com
